{
    "name": "high-performant-nodejs-boilerplate",
    "version": "1.0.0",
    "description": "Production-ready Fastify + Kysely + Prisma + Redis + Docker + Jenkins + Github CI/CD boilerplate",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/server.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "lint": "eslint src/**/*.ts",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev"
    },
    "keywords": [
        "fastify",
        "kysely",
        "prisma",
        "typescript",
        "boilerplate"
    ],
    "author": "Antigravity",
    "license": "ISC",
    "dependencies": {
        "@prisma/client": "6.0.1",
        "dotenv": "^16.4.7",
        "fastify": "^5.2.0",
        "fastify-type-provider-zod": "^4.0.2",
        "kysely": "0.27.5",
        "pg": "^8.13.1",
        "prisma": "6.0.1",
        "prisma-kysely": "^1.8.0",
        "redis": "^4.7.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.1",
        "@types/pg": "^8.11.10",
        "eslint": "^9.16.0",
        "jest": "^29.7.0",
        "pino-pretty": "^13.0.0",
        "ts-jest": "^29.2.5",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.19.2",
        "typescript": "5.7.2"
    },
    "engines": {
        "node": ">=24.11.1"
    }
}