{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@db/*": ["db/*"],
      "@controllers/*": ["controllers/*"],
      "@middlewares/*": ["middlewares/*"],
      "@routes/*": ["routes/*"],
      "@services/*": ["services/*"],
      "@utils/*": ["utils/*"],
      "@tests/*": ["tests/*"]
    },
    "types": ["node","jest"]
  },
  "include": ["src", "src/**/*.ts", "src/**/*.json", ".env"],
  "exclude": ["node_modules", "dist", "src/http", "src/logs", "src/tests"]
  }
